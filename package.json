{
  "name": "sharex-paste-front",
  "version": "0.0.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 4000",
    "build": "vite build",
    "start": "node build",
    "preview": "vite preview --port 4000",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && oxlint --deny-warnings && oxfmt --check . && tsc --noEmit",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "docker:build": "docker build --no-cache --pull --rm -t ghcr.io/busheezy/sharex-paste-front:latest .",
    "docker:push": "docker push ghcr.io/busheezy/sharex-paste-front:latest",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit"
  },
  "dependencies": {
    "diff": "^8.0.2",
    "marked": "^18.0.13",
    "sanitize-html": "^2.17.0",
    "shiki": "^4.4.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^24.10.1",
    "@types/sanitize-html": "^2.16.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@12.3.4"
}
